<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#ff4f91">
  <title>Happy Birthday Sujon Khan 🎂</title>

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      min-height: 100vh;
      min-height: 100svh;
      display: flex;
      justify-content: center;
      align-items: center;
      padding: 20px 14px;
      overflow-x: hidden;
      font-family: Arial, sans-serif;
      color: white;
      text-align: center;
      background: linear-gradient(
        135deg, #ff758c, #ff7eb3, #a18cd1, #667eea
      );
      background-size: 300% 300%;
      animation: gradient 10s ease infinite;
    }

    #confetti {
      position: fixed;
      inset: 0;
      width: 100%;
      height: 100%;
      pointer-events: none;
      z-index: 10;
    }

    .card {
      position: relative;
      z-index: 2;
      width: 100%;
      max-width: 440px;
      padding: 32px 22px;
      border-radius: 28px;
      border: 1px solid rgba(255,255,255,.4);
      background: rgba(255,255,255,.17);
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);
      box-shadow: 0 20px 50px rgba(50,0,60,.25);
      animation: entrance 1s ease-out;
    }

    .tag {
      display: inline-block;
      padding: 9px 15px;
      border-radius: 50px;
      background: rgba(255,255,255,.2);
      font-size: 12px;
      letter-spacing: 2px;
      margin-bottom: 20px;
    }

    .cake {
      font-size: clamp(75px, 22vw, 105px);
      margin: 5px 0 15px;
      animation: bounce 2s infinite;
      filter: drop-shadow(0 8px 12px rgba(0,0,0,.15));
    }

    h1 {
      font-size: clamp(32px, 9vw, 46px);
      line-height: 1.2;
      text-shadow: 0 4px 15px rgba(100,0,60,.2);
    }

    .name {
      display: inline-block;
      color: #fff4a3;
      overflow-wrap: anywhere;
      margin-top: 6px;
    }

    .subtitle {
      font-size: 17px;
      margin: 18px 0;
      line-height: 1.6;
    }

    .message {
      padding: 18px 14px;
      border-radius: 18px;
      background: rgba(255,255,255,.13);
      line-height: 1.8;
      font-size: 15px;
      margin-bottom: 23px;
    }

    button {
      width: 100%;
      min-height: 50px;
      padding: 14px;
      margin: 6px 0;
      border-radius: 50px;
      border: none;
      font-size: 15px;
      font-weight: bold;
      cursor: pointer;
      transition: transform .2s;
      -webkit-tap-highlight-color: transparent;
    }

    button:active {
      transform: scale(.96);
    }

    .celebrate {
      color: #ed4084;
      background: white;
      box-shadow: 0 7px 20px rgba(100,0,60,.2);
    }

    .music {
      color: white;
      background: rgba(255,255,255,.15);
      border: 1px solid rgba(255,255,255,.5);
    }

    .footer {
      margin-top: 22px;
      font-size: 12px;
      opacity: .9;
    }

    .heart {
      position: fixed;
      bottom: -40px;
      z-index: 1;
      pointer-events: none;
      animation: floatUp 4s linear forwards;
    }

    @keyframes gradient {
      0%, 100% { background-position: 0% 50%; }
      50% { background-position: 100% 50%; }
    }

    @keyframes entrance {
      from { opacity: 0; transform: translateY(25px) scale(.95); }
      to { opacity: 1; transform: translateY(0) scale(1); }
    }

    @keyframes bounce {
      0%, 100% { transform: translateY(0) rotate(-3deg); }
      50% { transform: translateY(-12px) rotate(3deg); }
    }

    @keyframes floatUp {
      to {
        transform: translateY(-115vh) rotate(360deg);
        opacity: 0;
      }
    }

    @media (max-width: 360px) {
      .card { padding: 25px 16px; }
      .message { font-size: 14px; }
    }

    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after {
        animation-duration: .01ms !important;
        animation-iteration-count: 1 !important;
      }
    }
  </style>
</head>

<body>
  <canvas id="confetti"></canvas>

  <main class="card">
    <div class="tag">✨ A SPECIAL DAY ✨</div>

    <div class="cake">🎂</div>

    <h1>
      Happy Birthday!
      <br>
      <span class="name">Sujon Khan</span> 🎉
    </h1>

    <p class="subtitle">
      Today is your special day! 🥳💖
    </p>

    <div class="message">
      🎁 Dear Sujon Khan,<br><br>
      May your birthday bring you endless happiness,
      lots of love, success, and beautiful memories.
      May all your dreams come true and your life
      always shine with joy! 🌟<br><br>
      Keep smiling, keep shining, and enjoy every
      moment of your special day! ❤️<br><br>
      🎂 Happy Birthday, Sujon Khan! 🎂
    </div>

    <button class="celebrate" onclick="celebrate()">
      🎉 Celebrate Now!
    </button>

    <button class="music" id="musicBtn" onclick="toggleMusic()">
      🎵 Play Birthday Music
    </button>

    <p class="footer">
      Made with ❤️ especially for Sujon Khan
    </p>
  </main>

  <script>
    // Confetti animation
    const canvas = document.getElementById("confetti");
    const ctx = canvas.getContext("2d");
    let pieces = [];
    let frame = null;

    function resize() {
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      canvas.width = innerWidth * dpr;
      canvas.height = innerHeight * dpr;
      canvas.style.width = innerWidth + "px";
      canvas.style.height = innerHeight + "px";
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    }

    window.addEventListener("resize", resize);
    resize();

    const colors = [
      "#fff176", "#ffffff", "#ff4081",
      "#69f0ae", "#7c83ff", "#ffab40"
    ];

    function burst(count = 180) {
      for (let i = 0; i < count; i++) {
        pieces.push({
          x: innerWidth * (0.2 + Math.random() * 0.6),
          y: innerHeight * 0.35,
          vx: (Math.random() - .5) * 11,
          vy: -Math.random() * 10 - 2,
          gravity: .15 + Math.random() * .1,
          size: 4 + Math.random() * 6,
          rotation: Math.random() * 6,
          spin: (Math.random() - .5) * .2,
          color: colors[Math.floor(Math.random() * colors.length)],
          life: 180
        });
      }

      if (!frame) animate();
    }

    function animate() {
      ctx.clearRect(0, 0, innerWidth, innerHeight);

      pieces = pieces.filter(p => p.life > 0 && p.y < innerHeight + 30);

      for (const p of pieces) {
        p.x += p.vx;
        p.y += p.vy;
        p.vy += p.gravity;
        p.rotation += p.spin;
        p.life--;

        ctx.save();
        ctx.translate(p.x, p.y);
        ctx.rotate(p.rotation);
        ctx.fillStyle = p.color;
        ctx.fillRect(-p.size / 2, -p.size / 2, p.size, p.size * .7);
        ctx.restore();
      }

      if (pieces.length) {
        frame = requestAnimationFrame(animate);
      } else {
        frame = null;
        ctx.clearRect(0, 0, innerWidth, innerHeight);
      }
    }

    function createHearts() {
      const emojis = ["💖", "💕", "✨", "💗", "🌸"];

      for (let i = 0; i < 15; i++) {
        const el = document.createElement("span");
        el.className = "heart";
        el.textContent = emojis[Math.floor(Math.random() * emojis.length)];
        el.style.left = Math.random() * 100 + "vw";
        el.style.fontSize = (20 + Math.random() * 20) + "px";
        el.style.animationDuration = (3 + Math.random() * 3) + "s";
        document.body.appendChild(el);
        el.addEventListener("animationend", () => el.remove());
      }
    }

    function celebrate() {
      burst(260);
      createHearts();
    }

    // Birthday melody generated by the browser
    let audio = null;
    let playing = false;
    let timer = null;
    let index = 0;

    const notes = [
      [262, 300], [262, 300], [294, 600],
      [262, 600], [349, 600], [330, 900],
      [262, 300], [262, 300], [294, 600],
      [262, 600], [392, 600], [349, 900],
      [262, 300], [262, 300], [523, 600],
      [440, 600], [349, 600], [330, 600],
      [294, 1000]
    ];

    function playNote(freq, duration) {
      if (!audio) return;

      const osc = audio.createOscillator();
      const gain = audio.createGain();

      osc.type = "sine";
      osc.frequency.value = freq;
      gain.gain.setValueAtTime(.001, audio.currentTime);
      gain.gain.linearRampToValueAtTime(.12, audio.currentTime + .04);
      gain.gain.setTargetAtTime(
        .001, audio.currentTime + duration / 1000 * .65, .08
      );

      osc.connect(gain);
      gain.connect(audio.destination);
      osc.start();
      osc.stop(audio.currentTime + duration / 1000);
    }

    async function toggleMusic() {
      const btn = document.getElementById("musicBtn");

      if (playing) {
        playing = false;
        clearInterval(timer);
        btn.textContent = "🎵 Play Birthday Music";
        return;
      }

      try {
        const AudioContextClass = window.AudioContext || window.webkitAudioContext;
        if (!AudioContextClass) {
          btn.textContent = "Music not supported";
          return;
        }

        if (!audio) audio = new AudioContextClass();
        await audio.resume();

        playing = true;
        btn.textContent = "⏸ Stop Birthday Music";

        function next() {
          if (!playing) return;
          const [freq, duration] = notes[index];
          playNote(freq, duration);
          index = (index + 1) % notes.length;
        }

        next();
        timer = setInterval(next, 450);
      } catch (e) {
        btn.textContent = "Please try again";
      }
    }

    // Initial celebration
    window.addEventListener("load", () => {
      setTimeout(() => burst(120), 500);
    });
  </script>
</body>
</html>
